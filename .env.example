# ==============================================================================
# Food Delivery Order Management System - Root Environment Template
# Copy to .env and fill in strong secrets before running in production.
# NEVER commit real .env files to source control.
# ==============================================================================

# Shared JWT & Inter-Service Security
JWT_SECRET_KEY=change-this-to-a-strong-256-bit-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
INTERNAL_API_KEY=change-this-to-a-strong-internal-service-key

# CORS (comma-separated frontend origins for production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pricing Rules (order-service)
TAX_PERCENTAGE=5.0
FREE_DELIVERY_THRESHOLD=500.0
DEFAULT_DELIVERY_FEE=40.0

# Service URLs (Local Defaults)
API_GATEWAY_URL=http://127.0.0.1:8000
USER_SERVICE_URL=http://127.0.0.1:8001
RESTAURANT_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_URL=http://127.0.0.1:8003
DELIVERY_SERVICE_URL=http://127.0.0.1:8004
RATING_SERVICE_URL=http://127.0.0.1:8005
REPORT_SERVICE_URL=http://127.0.0.1:8006
MENU_SERVICE_URL=http://127.0.0.1:8007
AUTH_SERVICE_URL=http://127.0.0.1:8008

# Example MySQL Database URLs (one per microservice)
# AUTH_DATABASE_URL=mysql+pymysql://root:root@localhost:3308/auth_db
# USER_DATABASE_URL=mysql+pymysql://root:root@localhost:3301/user_db
# RESTAURANT_DATABASE_URL=mysql+pymysql://root:root@localhost:3302/restaurant_db
# MENU_DATABASE_URL=mysql+pymysql://root:root@localhost:3307/menu_db
# ORDER_DATABASE_URL=mysql+pymysql://root:root@localhost:3303/order_db
# DELIVERY_DATABASE_URL=mysql+pymysql://root:root@localhost:3304/delivery_db
# RATING_DATABASE_URL=mysql+pymysql://root:root@localhost:3305/rating_db
# REPORT_DATABASE_URL=mysql+pymysql://root:root@localhost:3306/report_db

LOG_LEVEL=INFO
ENVIRONMENT=development
